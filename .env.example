# === API Keys ===
# At least one LLM provider is required for content generation
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# === Social Platform API Keys (optional - enables richer data) ===
# Twitter/X
TWITTER_BEARER_TOKEN=
# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# YouTube
YOUTUBE_API_KEY=

# === Database ===
DATABASE_URL=sqlite:///socialmonitor.db

# === Scheduling ===
# How often to refresh trends (minutes)
TREND_REFRESH_INTERVAL=60
# How often to refresh influencer data (minutes)
INFLUENCER_REFRESH_INTERVAL=360
